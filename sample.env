API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=
# ── MongoDB: two separate clusters ──
# MONGO_URL      → the CHAT/TRAINING brain only (Word.WordDb: learned replies
#                  + stickers). The bot never writes anything else here.
# BOT_MONGO_URL  → everything the bot owns: users, chats, admins, userbot
#                  accounts, sessions, clones, settings and AI keys
#                  (Anonymous, UserbotDB, SessionDB, BotDB, MYRADb).
# Leave BOT_MONGO_URL empty to keep the old single-cluster behaviour.
MONGO_URL=
BOT_MONGO_URL=
OWNER_USERNAME=
SUPPORT_GRP=
UPDATE_CHNL=
USERBOT_AUTOCHAT_DEFAULT=true

# ── Userbot speed (milliseconds) ──
USERBOT_SPEED_DEFAULT_MS=0

# ── Hybrid AI (Google Gemini) ──
# Multiple keys, comma separated. Rotation is automatic on 429 / invalid key.
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.0-flash

# ── Hybrid AI (OpenAI / ChatGPT) — optional second provider ──
# Works with api.openai.com AND with any OpenAI-compatible proxy (OpenRouter,
# Groq, ...): point OPENAI_BASE_URL at the proxy and paste the key here.
# Add more keys at runtime with: /addkey openai <key> [base_url]
OPENAI_API_KEYS=sk-xxxxxxxx
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ENABLE=true
# Which provider is asked first when the database has no answer.
AI_PROVIDER_ORDER=gemini,openai

# Master switches
AI_ENABLE=true
AI_DB_FIRST=true
AI_AUTO_TRAIN=true
AI_PRIVATE_FALLBACK=true
AI_GROUP_FALLBACK=true

# Similarity search / rotation tuning
AI_SIMILARITY_THRESHOLD=0.72
AI_SEARCH_CANDIDATES=80
AI_MAX_OUTPUT_TOKENS=160
AI_KEY_COOLDOWN=60
